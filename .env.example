# Development PostgreSQL values used by the root Compose stack.
POSTGRES_DB=haris_payroll
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
HTTP_PORT=80

# Optional overrides for local development. Compose provides development-only
# defaults, so backend/.env and frontend/.env are not required by Docker.
# Replace these sample secrets before sharing a deployment.
AUTH_JWT_SECRET=development-only-jwt-secret-change-before-sharing
# AUTH_ALLOWED_ORIGINS defaults to localhost with HTTP_PORT and localhost:3000.
# Set exact browser origins here when accessing through another hostname.
# AUTH_ALLOWED_ORIGINS=http://localhost
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_SECONDS=900
EMPLOYEE_BANK_ENCRYPTION_KEY_VERSION=v1
EMPLOYEE_BANK_ENCRYPTION_KEYS='{"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'

# Mock placeholders only: .invalid never delivers external email. Replace for real SMTP.
# Verification overrides these values with the local Mailpit connection.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mock-smtp-user
SMTP_PASSWORD=mock-smtp-password
SMTP_FROM=payroll@example.invalid
