# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_DB=haris_payroll
POSTGRES_USER=haris_payroll
POSTGRES_PASSWORD=replace-with-a-strong-secret
DATABASE_URL=postgresql://haris_payroll:replace-with-a-strong-secret@postgres:5432/haris_payroll
HTTP_PORT=80

# Backend authentication. Use a unique random value of at least 32 characters.
AUTH_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_ALLOWED_ORIGINS=https://payroll.example.com
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_SECONDS=900

# Versioned AES-256-GCM keyring for employee bank-account data.
# Replace the sample with a securely generated 32-byte base64 key.
EMPLOYEE_BANK_ENCRYPTION_KEY_VERSION=v1
EMPLOYEE_BANK_ENCRYPTION_KEYS={"v1":"replace-with-a-32-byte-base64-key"}
